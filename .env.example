# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Job sources (missing keys cause that source to be skipped; Remotive needs no key)
RAPIDAPI_KEY=your_rapidapi_key_here
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
JOOBLE_API_KEY=your_jooble_key_here
JOB_QUERIES=javascript developer,devops engineer
JOB_LOCATION=Washington, DC
JOB_DATE_POSTED=week
EXCLUDE_CLEARANCE=true   # skip jobs requiring a security clearance

# AI provider chain: gemini | groq | ollama | openrouter | anthropic
LLM_PROVIDER=groq                    # primary
LLM_FALLBACKS=gemini,ollama          # tried in order if the primary fails
LLM_MODEL=                           # blank = primary provider's default
# Provider defaults: gemini→gemini-2.0-flash, groq→llama-3.3-70b-versatile,
#                    ollama→qwen2.5:7b, openrouter→meta-llama/llama-3.3-70b-instruct
LLM_API_KEY=                         # optional override applied to whichever provider runs

# Per-provider keys — each is used when that provider runs in the chain
GEMINI_API_KEY=your_gemini_key_here     # create at https://aistudio.google.com/apikey
GROQ_API_KEY=your_groq_key_here         # https://console.groq.com/keys
OPENROUTER_API_KEY=your_openrouter_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

MIN_MATCH_SCORE=50   # jobs scoring below this are silently skipped
PRESCREEN_MIN_MATCHES=2   # resume-skill hits required before a job is sent to the LLM

# Web dashboard
WEB_PORT=3000

# Scheduler (cron syntax, default: every 4 hours)
CRON_SCHEDULE=0 */4 * * *
RUN_ON_START=true   # catch-up scan 15s after the agent starts
