# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Job sources (missing keys cause that source to be skipped; Remotive needs no key)
RAPIDAPI_KEY=your_rapidapi_key_here
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
JOOBLE_API_KEY=your_jooble_key_here
JOB_QUERIES=javascript developer,devops engineer
JOB_LOCATION=Washington, DC
JOB_DATE_POSTED=week
EXCLUDE_CLEARANCE=true   # skip jobs requiring a security clearance

# Claude / Anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
MIN_MATCH_SCORE=50   # jobs scoring below this are silently skipped

# Web dashboard
WEB_PORT=3000

# Scheduler (cron syntax, default: every 4 hours)
CRON_SCHEDULE=0 */4 * * *
