# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Job sources (missing keys cause that source to be skipped; Remotive needs no key)
RAPIDAPI_KEY=your_rapidapi_key_here
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
JOOBLE_API_KEY=your_jooble_key_here
# Google Jobs (aggregates Indeed/ZipRecruiter/LinkedIn)
SERPAPI_KEY=your_serpapi_key_here
# stay under the 250/mo free tier
SERPAPI_MONTHLY_LIMIT=240
# pace SerpApi (once/day) so the budget lasts the month
SERPAPI_MIN_INTERVAL_HOURS=24
# comma-separated; each runs against every source. Quote values with spaces.
JOB_QUERIES="forward deployed engineer,full stack developer,front end developer"
# "United States" = nationwide (onsite + hybrid + remote); or name a city/region to narrow
JOB_LOCATION="United States"
JOB_DATE_POSTED=month
# skip jobs requiring a security clearance
EXCLUDE_CLEARANCE=true
# comma-separated apply-URL domains to drop (low-trust aggregators)
BLOCKED_DOMAINS=lensa.com,jobleads.com,recruit.net
# drop these role families by title (not targeting these)
EXCLUDED_ROLES="devops,site reliability,sre,platform engineer,platform engineering,infrastructure engineer,infrastructure engineering"

# AI provider chain: gemini | groq | ollama | openrouter | anthropic
# primary provider
LLM_PROVIDER=groq
# fallbacks tried in order if the primary fails
LLM_FALLBACKS=gemini,ollama
# blank = primary provider's default
LLM_MODEL=
# Provider defaults: gemini->gemini-2.5-flash, groq->llama-3.3-70b-versatile,
#                    ollama->qwen2.5:7b, openrouter->meta-llama/llama-3.3-70b-instruct
# optional override applied to whichever provider runs
LLM_API_KEY=

# Per-provider keys — each is used when that provider runs in the chain
# create at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# record floor: jobs below this are discarded (not stored)
MIN_MATCH_SCORE=50
# notify gate: only jobs at/above this trigger a Telegram alert;
# [MIN_MATCH_SCORE, this) is stored silently for dashboard review
# (defaults to MIN_MATCH_SCORE if unset)
NOTIFY_MATCH_SCORE=80
# jobs at/above this get a ⭐ TOP MATCH priority alert
TOP_MATCH_SCORE=85
# resume-skill hits required before a job is sent to the LLM
PRESCREEN_MIN_MATCHES=2

# Web dashboard
WEB_PORT=3000

# Scheduler (cron syntax, default: every 4 hours). Quoted so the launchd
# installer's shell sourcing doesn't glob the '*' characters.
CRON_SCHEDULE="0 */4 * * *"
RUN_ON_START=true
